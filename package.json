{
  "name": "dsh-question-recovery",
  "version": "0.1.4",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "author": "vb2250158",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-question-recovery.git"
  },
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-question-recovery/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt"
  ],
  "description": "Explicit follow-up answers for interrupted DSH questions",
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0"
  },
  "icon": "./icon.svg"
}
